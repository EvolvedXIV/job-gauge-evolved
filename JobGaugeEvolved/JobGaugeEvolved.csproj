<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>0.3.0.0</Version>
        <Description>Improved, customisable job gauges.</Description>
        <PackageProjectUrl>https://github.com/EvolvedXIV/job-gauge-evolved</PackageProjectUrl>
        <IsPackable>false</IsPackable>
        <!-- Lets the Windows-targeted project build on Linux/macOS (CI, XIVLauncher.Core users). -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
    </PropertyGroup>

    <ItemGroup>
        <!-- Gauge art, generated by scripts/render_art.js from art/. Loaded by ArtAtlas as "Assets/<folder>/<file>". -->
        <EmbeddedResource Include="Assets\**\*.png;Assets\**\*.json" LogicalName="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
